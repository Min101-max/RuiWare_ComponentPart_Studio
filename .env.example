# Zero-part template API address, without /api suffix.
RUIWARE_TEMPLATE_API_URL=http://127.0.0.1:8010

# Same read-only integration key as the zero-part platform.
# Copy this file to .env.local, fill in the real key, then restart FastAPI.
# Never use a VITE_ prefix for this key: it must stay on the server.
RUIWARE_PUBLIC_API_KEY=

# Shared drafts (default: .runtime/components.sqlite3).
COMPONENT_DRAFT_DB=.runtime/components.sqlite3

# Optional independent inbound MCP bearer token. Empty: loopback clients only.
# This protects /mcp only; remote deployment must also protect REST and the web app.
COMPONENT_MCP_TOKEN=

# Origin used in model URLs returned by MCP; no path suffix.
COMPONENT_PUBLIC_BASE_URL=http://127.0.0.1:8020
